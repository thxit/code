{
  "name": "text-to-speech-app",
  "version": "1.0.0",
  "description": "A text to speech desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "keywords": [
    "text-to-speech",
    "tts",
    "speech"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "msedge-tts": "^2.0.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.example.text-to-speech",
    "productName": "Text to Speech",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Text to Speech"
    },
    "portable": {
      "artifactName": "TextToSpeech-Portable-${version}.exe"
    },
    "copyright": "Copyright (c) 2026 Text to Speech",
    "files": [
      "main.js",
      "index.html",
      "script.js",
      "style.css",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}