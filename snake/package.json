{
  "name": "markdown-editor",
  "version": "1.0.0",
  "description": "A simple and elegant Markdown editor like Typora",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "markdown",
    "editor",
    "typora"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.example.markdown-editor",
    "productName": "Markdown Editor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown File",
          "description": "Markdown document"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "fileAssociations": [
        {
          "ext": "md",
          "mimeType": "text/markdown"
        }
      ]
    }
  }
}