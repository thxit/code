{
  "name": "markdown-editor",
  "version": "1.0.0",
  "description": "A simple and elegant Markdown editor like Typora",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "keywords": [
    "markdown",
    "editor",
    "typora"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.example.markdown-editor",
    "productName": "Markdown Editor",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown File",
          "description": "Markdown document"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown Editor"
    },
    "portable": {
      "artifactName": "MarkdownEditor-Portable-${version}.exe"
    },
    "copyright": "Copyright (c) 2026 Markdown Editor",
    "files": [
      "main.js",
      "index.html",
      "script.js",
      "style.css",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "fileAssociations": [
        {
          "ext": "md",
          "mimeType": "text/markdown"
        }
      ]
    }
  }
}